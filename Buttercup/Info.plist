<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.adamfilchoir.buttercup</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>buttercup</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>buttercup uses the camera so your partner can see you on video calls and so you can take photos for notes.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>buttercup uses the microphone so your partner can hear you on calls.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>buttercup connects to the development server on your Mac while testing.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
